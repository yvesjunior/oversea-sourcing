# ─────────────────────────────────────────────────────────────────────────────
# OSI — environment template.
#
# Copy this to .env and fill in the values:   cp .env.example .env
#
# .env is GITIGNORED and holds everything: config AND secrets (changed
# 2026-08-16 — the old split of a committed .env plus a gitignored .env.local
# was merged into this one file). Never commit .env.
#
# NODE_ENV and the host port are intentionally NOT set here:
#   - NODE_ENV is set per environment by compose (dev vs prod). Pinning it here
#     breaks production builds (the dev JSX runtime leaks in).
#   - The exposed host port defaults to 3010 everywhere; override per run with
#     `WEB_PORT=<port> docker compose ...`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets ──────────────────────────────────────────────────────────────────
# Dev can use throwaway values; production must not.

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://osi:change-me@database:5432/osi

# 32+ characters. Leaking this lets anyone forge a session cookie for any user.
BETTER_AUTH_SECRET=change-me-to-32-plus-random-characters

# MUST be the public origin in production (https://osi-solutions.com), or
# better-auth rejects logins from the domain with INVALID_ORIGIN.
BETTER_AUTH_URL=http://localhost:3010

# Required for AI features (E4 research, and the chat when enabled).
# Without it the research job records a failed run and the pipeline continues.
ANTHROPIC_API_KEY=

# Optional — Google sign-in activates automatically once both are set.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ── AI ───────────────────────────────────────────────────────────────────────

# Per-request assistant chat on the dossier. Needs ANTHROPIC_API_KEY.
AI_CHAT=false

# E4 — "Recherche mondiale", literally: the worker runs a real web search per
# request and enriches the platform-global supplier pool. Spends money on every
# request (~$0.06 at the cheap tier), so it stays a flag: set false to fall back
# to the simulated search stage if cost or the API misbehaves.
AI_RESEARCH=true

# Research + chat model. Accepts a TIER or a raw model id — the registry in
# src/server/ai/models.ts maps each tier to its model, its web-search tool
# variant and its price, and the worker logs an estimated cost per run.
#
#   cheap     claude-haiku-4-5   ~$0.06/request   half the recall; no result filtering
#   balanced  claude-sonnet-5    ~$0.21/request   no cheaper than best in practice
#   best      claude-opus-5      ~$0.11-0.20      cleanest results, fastest
#
# Switching is this line plus a container restart — no code change.
ANTHROPIC_MODEL=cheap

# How many suppliers the buyer gets back on a dossier. THE number to tune here.
# Everything else the research agent does — how many web searches it runs, how
# many companies it may propose — is derived from this in
# src/server/sourcing-config.ts, so asking for more results automatically
# searches wider instead of returning a thinner shortlist. Range 1-20.
SUPPLIERS_RETURNED=5

# Turning prose into rows does not need the strong model (doc/INFRA.md §4).
# ANTHROPIC_EXTRACTION_MODEL=claude-haiku-4-5

# ── Test phase ───────────────────────────────────────────────────────────────

# Shows the one-click demo-account login box on /login outside dev builds (dev
# always shows it). Set to false before real users — the seeded credentials are
# public in the README, and with AI_RESEARCH on, each submitted request spends
# API budget.
SHOW_TEST_LOGIN=true

# ── Storage ──────────────────────────────────────────────────────────────────
# UPLOAD_DIR=/data/uploads              # compose mounts a named volume here

# Optional: Redis for distributed rate limiting (the `cache` addon).
# Unset = in-memory counters (fine for one web container).
# With the addon: REDIS_URL=redis://redis:6379
# REDIS_URL=

# ── Email (SendGrid — decided 2026-08-23) ────────────────────────────────────
# Prod-only, like the Google credentials: absent in dev, where sends are
# logged to stdout instead of delivered. The sender address MUST be verified
# in SendGrid (single-sender or domain authentication on osi-solutions.com).
# SENDGRID_API_KEY=
# MAIL_FROM=no-reply@osi-solutions.com
# MAIL_FROM_NAME=OSI — Oversea Sourcing Intelligence
